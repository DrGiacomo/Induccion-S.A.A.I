# ═══════════════════════════════════════════════════════════════
#  S.A.A.I — Plantilla de variables de entorno
# ═══════════════════════════════════════════════════════════════
#  ESTE archivo SI se versiona. El que NO se versiona es `.env`.
#
#  Para arrancar el proyecto:
#     1. Copia este archivo:   cp .env.example .env
#     2. Rellena cada valor con los tuyos.
#     3. Genera tu SECRET_KEY:
#          python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
#  Regla: aqui van los NOMBRES de las variables y su explicacion.
#  NUNCA valores reales. Si copias aqui una clave de verdad, la acabas
#  de publicar.
# ═══════════════════════════════════════════════════════════════


# ── Django ─────────────────────────────────────────────────────

# Clave criptografica. Firma sesiones, cookies y tokens.
# Si se filtra, cualquiera puede falsificar la sesion de un
# administrador. Se genera una distinta por instalacion.
SECRET_KEY=pon-aqui-tu-clave-generada

# Modo depuracion.
# SIEMPRE False en produccion: con True, cualquier error muestra el
# codigo fuente, las rutas del servidor y parte de la configuracion
# a quien visite la pagina.
DEBUG=True

# Dominios desde los que se acepta servir la aplicacion.
# Separados por coma, sin espacios. En produccion va el dominio real.
ALLOWED_HOSTS=localhost,127.0.0.1


# ── Base de datos ──────────────────────────────────────────────

# Conexion completa en una sola cadena, con el formato:
#     motor://usuario:contrasena@servidor:puerto/nombre_base
#
# Ejemplos:
#     postgres://saai:tu_clave@localhost:5432/saai
#     mysql://root:tu_clave@localhost:3307/induccion
#
# Se usa una sola cadena en vez de cinco variables sueltas porque es
# lo que esperan los servicios de nube y porque cambiar de motor
# -o de servidor- se vuelve una sola linea.
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/saai


# ── Frontend ───────────────────────────────────────────────────

# Origenes autorizados a llamar a la API desde el navegador.
# Separados por coma. En desarrollo es el servidor de Vite.
# NUNCA poner "*" aqui: abriria la API a cualquier pagina de internet.
CORS_ALLOWED_ORIGINS=http://localhost:5173
